{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["APP_VARIANT", "EAS_BUILD"],
  "globalEnv": [
    "CXR_SERVICE_URL",
    "CXR_THRESHOLD",
    "IMAGING_SERVICE_URL",
    "MRI_BRAIN_MODEL",
    "US_BREAST_MODEL",
    "CT_CHEST_MODEL",
    "MEDISCAN_DATA_FILE",
    "ANTHROPIC_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#lint": {
      "cache": false
    },
    "outdated": {
      "cache": false,
      "interactive": true
    },
    "clean": {
      "cache": false
    }
  }
}
